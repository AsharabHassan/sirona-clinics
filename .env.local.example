# ─────────────────────────────────────────────────────────────
# Sirona Aesthetics — "Veluria for Clinics" clinic-owner demo funnel
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit it.
#   cp .env.local.example .env.local
#
# Covers every variable this app reads. Anything under "optional" has a
# working code default, shown in its comment — leave it unset to take that.
#
# This is the B2B fork: the audience is clinic owners, not patients. Its CRM
# and pixel are SIRONA'S, not a client clinic's.
# ─────────────────────────────────────────────────────────────

# ── Lead capture and tracking ──

# Meta (Facebook) Pixel — SIRONA'S pixel. Fires PageView, ViewContent
# ("DemoViewed"), and Lead, plus the Conversions API fields forwarded to GHL.
# Leave unset locally; set the real Sirona pixel before any campaign.
NEXT_PUBLIC_META_PIXEL_ID=

# GoHighLevel inbound webhook (Workflows -> Inbound Webhook trigger) — SIRONA's
# CRM. Clinic-owner leads are POSTed here as JSON, carrying the Meta CAPI block
# so GHL fires a deduped server-side Lead event. If unset, the lead is logged
# and the flow still completes.
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/...

# Sirona's free 20-minute online clinic consultation calendar for optional
# report/integration paths. The primary B2B CTA is fixed in app/page.tsx.
NEXT_PUBLIC_CALENDAR_URL=https://link.sironaaesthetics.co.uk/widget/bookings/veluria-clinic-growth-map

# A private 32+ character secret used to encrypt recipient attribution tokens.
# Generate independently for production and never reuse an API key.
OUTREACH_TOKEN_SECRET=

# Dedicated Sirona GoHighLevel inbound webhook for landing, AI, report and
# consultation events. The receiving workflow must match contact_id and update
# only the Sirona Aesthetics contact in location OdylxFk47CSXq3mt6RoF.
GHL_OUTREACH_EVENT_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/...


# ── Optional: only used by the "Try it on a real photo" live demo path ──

# Anthropic — the written skin analysis (Claude vision)
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI — the before/after image (gpt-image-2 edits endpoint)
OPENAI_API_KEY=sk-...


# ── Report delivery (optional — flow completes without these) ──
# Present in this fork's code but unconfigured: the B2B funnel books a
# walkthrough rather than emailing a patient report.

# GoHighLevel Private Integration token (pit-...).
GHL_API_TOKEN=
# GHL sub-account (location) id
GHL_LOCATION_ID=
# Bare GHL custom-field key (no "contact." prefix) the report URL is written into.
GHL_REPORT_FIELD_KEY=facial_app_report_pdf

# General clinic website — used for brand links (e.g. the report email signature).
NEXT_PUBLIC_SITE_URL=https://sironaaesthetics.co.uk/

# Optional patient-report booking override. The B2B clinic funnel uses the
# calendar URL above.
NEXT_PUBLIC_BOOKING_URL=


# ── Image generation tuning (optional — all have defaults) ──

# Candidates generated per after-image, best-of picked by the verifier. Default: 4
# AFTER_CANDIDATES=4
# Streamed partial images per candidate. Default: 3
# AFTER_PARTIAL_IMAGES=3
# Wall-clock budget for the whole after-image step, ms. The route must finish
# inside the platform's 300s ceiling. Default: 240000
# AFTER_MAX_WAIT_MS=240000
# Quality tier: low | medium | high. Default: medium
# AFTER_QUALITY=medium
# Quality for the one retry when the first pass is rejected. Default: medium
# AFTER_RESCUE_QUALITY=medium
# Post-process strength, 0 disables. Defaults: 2 and 2
# GLOW_STRENGTH=2
# FIRMNESS_STRENGTH=2
