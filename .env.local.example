# ─────────────────────────────────────────────────────────────
# Sirona Aesthetics — "Veluria for Clinics" clinic-owner demo funnel
# ─────────────────────────────────────────────────────────────

# Meta (Facebook) Pixel — SIRONA'S pixel. Fires PageView, ViewContent
# ("DemoViewed"), and Lead, plus the Conversions API fields forwarded to GHL.
# Leave unset locally; set the real Sirona pixel before any campaign.
NEXT_PUBLIC_META_PIXEL_ID=

# GoHighLevel inbound webhook (Workflows -> Inbound Webhook trigger) — SIRONA's
# CRM. Clinic-owner leads are POSTed here as JSON, carrying the Meta CAPI block
# so GHL fires a deduped server-side Lead event. If unset, the lead is logged
# and the flow still completes.
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/...

# Sirona's private-walkthrough calendar. The public webinar URL is configured
# separately in app/page.tsx.
NEXT_PUBLIC_CALENDAR_URL=https://sironaaesthetics.co.uk/contact

# ── Optional: only used by the "Try it on a real photo" live demo path ──
# Anthropic — the written skin analysis (Claude vision)
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI — the before/after image (gpt-image-2 edits endpoint)
OPENAI_API_KEY=sk-...
